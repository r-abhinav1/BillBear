# --- Vision receipt scanning ---------------------------------------------
# Comma-separated; one key is picked at random per scan, a second only on 429/5xx/timeout.
GEMINI_API_KEYS=your_gemini_api_key_here
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite
# Leave empty for Flash-Lite's default ("minimal"); thinking tokens are billed as output.
GEMINI_THINKING_LEVEL=
# Max scans per day across ALL users (window resets 00:00 UTC = 05:30 IST).
# ~₹0.15/scan on 3.1 Flash-Lite -> 15/day ≈ ₹800/yr before GST.
SCAN_DAILY_CAP=15
# Optional best-effort fallback
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# Total time the scan endpoint may spend on providers (Vercel's default function limit is 300s)
VISION_BUDGET_SECONDS=25
VISION_CALL_TIMEOUT_SECONDS=15
GEMINI_CIRCUIT_OPEN_SECONDS=300

# --- Flask ---------------------------------------------------------------
# REQUIRED in production (>= 32 random chars). The app refuses to start on Vercel without it.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
FLASK_DEBUG=false
PORT=5001
# Set to true to mark cookies Secure when testing over https locally (automatic on Vercel)
COOKIE_SECURE=false
# Trust X-Forwarded-Proto/Host from a proxy (set true when testing via ngrok; automatic on Vercel)
TRUST_PROXY=false

# --- Postgres (Supabase in prod, local Docker for dev) --------------------
# App runtime: Supabase *transaction pooler* URL (port 6543).
DATABASE_URL=postgresql://billbear:billbear@localhost:54329/billbear
# Migrations: Supabase *session pooler* URL (port 5432 on the pooler host).
DATABASE_URL_UNPOOLED=postgresql://billbear:billbear@localhost:54329/billbear
# Tests (pytest). Point at a throwaway database — tests TRUNCATE all tables.
TEST_DATABASE_URL=postgresql://billbear:billbear@localhost:54329/billbear_test
# Rooms expire this long after their last write
ROOM_TTL_SECONDS=86400

# --- Cron ----------------------------------------------------------------
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/cleanup
CRON_SECRET=

# --- Optional bot check (Cloudflare Turnstile) ---------------------------
# Leave empty to disable. When set, /create and /api/receipt/scan require a token.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
