GEMINI_API_KEYS=your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Flask
SECRET_KEY=change-this-to-a-long-random-string-in-production
FLASK_DEBUG=false
PORT=5001

# Redis (required for Vercel — use Upstash free tier)
# Upstash provides rediss:// URLs which work out of the box
REDIS_URL=rediss://default:your_password@your-endpoint.upstash.io:6379

# Optional feature flags
OCR_TEXT_INGESTION_ENABLED=true
CLIENT_OCR_ENABLED=true
LEGACY_IMAGE_OCR_ENABLED=false
# Set to false to only call LLM when parser confidence is low (saves cost)
ALWAYS_USE_LLM_NORMALIZATION=false

# Optional parser/provider tuning
PARSER_CONFIDENCE_THRESHOLD=0.72
# Vercel free tier has a 10s hard function timeout.
# Each provider gets this many seconds. If you have two providers configured
# (Gemini + OpenRouter fallback), worst case is 2x this value — keep the total
# under 9s to leave headroom. Recommended: 4s (Vercel free) or 8s (Vercel Pro).
OCR_PROVIDER_TIMEOUT_SECONDS=4
OCR_PROVIDER_MAX_ATTEMPTS=1
# How long (seconds) to keep Gemini's circuit breaker open after quota exhaustion
GEMINI_CIRCUIT_OPEN_SECONDS=300

# Optional provider model overrides
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=openai/gpt-4o-mini
